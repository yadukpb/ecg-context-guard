PORT=4000
# Leave MONGO_URI unset for local use — a self-managed embedded MongoDB starts
# automatically, no Docker or separate MongoDB install needed. Set it only to point at a
# real MongoDB (e.g. MongoDB Atlas in production):
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/ecg_context_guard
JWT_SECRET=dev-only-jwt-secret-change-me
TRANSPORT_SECRET=dev-only-shared-secret-change-me
DETECTOR_BASE_URL=http://localhost:8000
CLIENT_ORIGIN=http://localhost:5173
